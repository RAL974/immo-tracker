#!/bin/sh
# Bloque le push si la vérification (node --check + tests) échoue.
# Installé via "git config core.hooksPath .githooks" (fait automatiquement par "npm install",
# voir le script "prepare" dans package.json — sinon lancer la commande une fois manuellement).
# Pour outrepasser volontairement (déconseillé) : git push --no-verify.

echo "pre-push : vérification (node --check + tests)..."
npm run verify --silent
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "❌ Vérification échouée — push annulé. Corrige l'erreur ci-dessus, ou force avec 'git push --no-verify' si tu es sûr."
  exit 1
fi

echo "✅ Vérification OK."
exit 0
